{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "Subject Group": {
      "type": "object",
      "description": "Choose subject group to generate collar voltage charts and overall speedmap",
      "ecoscope:task_group": true,
      "properties": {
        "subject_group_var": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Subject Group Name",
              "type": "string",
              "description": "The EarthRanger subject group to report on, picked from the chosen data source's subject groups.",
              "ecoscope:transform": [
                {
                  "transformer": "EarthRangerEnumResolver",
                  "transformer_kws": {
                    "type": "subject_group_name",
                    "depends_on": "properties.er_client_name.properties.data_source.properties.name"
                  }
                }
              ]
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": "Set subject group name"
        }
      }
    },
    "Map Zoom & Extent": {
      "type": "object",
      "description": "Calculate the geographic extent of the movement tracks and determine an appropriate zoom level and center point for the map. This ensures that all tracks are visible and well-framed when the map is rendered.",
      "ecoscope:task_group": true,
      "properties": {
        "zoom_to_envelope": {
          "additionalProperties": false,
          "properties": {
            "expansion_factor": {
              "default": 1.5,
              "description": "Factor to expand the bounding box (e.g., 1.2 = 20% larger)",
              "ecoscope:advanced": true,
              "title": "Expansion Factor",
              "type": "number"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "Elliptical Time Density": {
      "type": "object",
      "description": "These settings show a grid-based heatmap showing where subjects spent the most time.",
      "ecoscope:task_group": true,
      "properties": {
        "td": {
          "additionalProperties": false,
          "properties": {
            "auto_scale_or_custom_cell_size": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AutoScaleGridCellSize"
                },
                {
                  "$ref": "#/$defs/CustomGridCellSize"
                }
              ],
              "default": {
                "auto_scale_or_custom": "Auto-scale"
              },
              "ecoscope:advanced": true,
              "title": "Grid Cell Size"
            },
            "max_speed_factor": {
              "default": 1.05,
              "description": "An estimate of the subject's maximum speed as a factor of the maximum measured speed value in the dataset.",
              "ecoscope:advanced": true,
              "title": "Max Speed Factor (Kilometers per Hour)",
              "type": "number"
            },
            "expansion_factor": {
              "default": 1.05,
              "description": "Controls how far time density values spread across the grid, affecting the smoothness of the output.",
              "ecoscope:advanced": true,
              "title": "Shape Buffer Expansion Factor",
              "type": "number"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "AutoScaleGridCellSize": {
      "properties": {
        "auto_scale_or_custom": {
          "const": "Auto-scale",
          "default": "Auto-scale",
          "ecoscope:advanced": true,
          "title": "Grid Cell Size",
          "type": "string"
        }
      },
      "title": "Auto-scale",
      "type": "object"
    },
    "CustomGridCellSize": {
      "properties": {
        "auto_scale_or_custom": {
          "const": "Customize",
          "default": "Customize",
          "ecoscope:advanced": true,
          "title": "Grid Cell Size",
          "type": "string"
        },
        "grid_cell_size": {
          "default": 5000,
          "description": "Define the resolution of the raster grid (in the unit of measurement defined by the coordinate reference system set below). A smaller grid cell size provides more detail, while a larger size generalizes the data.",
          "exclusiveMaximum": 10000,
          "exclusiveMinimum": 0,
          "gt": 0,
          "lt": 10000,
          "title": "Custom Grid Cell Size",
          "type": "number"
        }
      },
      "title": "Customize",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "oneOf": [
            {
              "const": "subject_name",
              "title": "Subject Name"
            },
            {
              "const": "subject_sex",
              "title": "Subject Sex"
            },
            {
              "const": "subject_subtype",
              "title": "Subject Subtype"
            }
          ]
        }
      }
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "Elliptical Time Density": {
      "td": {
        "ui:order": [
          "auto_scale_or_custom_cell_size",
          "max_speed_factor",
          "expansion_factor"
        ]
      }
    },
    "ui:order": [
      "workflow_details",
      "time_range",
      "er_client_name",
      "Subject Group",
      "Map Zoom & Extent",
      "Elliptical Time Density"
    ]
  },
  "additionalProperties": false
}
